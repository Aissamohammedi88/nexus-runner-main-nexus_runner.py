# 1. Sauvegarder le .gitignorenano .gitignore
# (coller le contenu ci-dessus)
# Ctrl+O, Enter, Ctrl+X

# 2. Vérifier qu'il fonctionne
git status --ignored

# 3. Tu dois voir dans "Ignored files" :
# logs/
# procs/
# __pycache__/
# .DS_Store
# *.log
# etc.

# 4. Vérifier qu'aucun fichier sensible n'est tracké
git ls-files | grep -E "\.(log|pid|db|key|pem)$"
# → doit ne rien retourner






# NEXUS RUNNER — Git attributes# Force LF endings on all text files

* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary



root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Créer le repo sur GitHub : nexus-runnergit clone https://github.com/Aissamohammedi88/nexus-runner.git
cd nexus-runner

# Copier tous les fichiers
cp /chemin/vers/nexus_runner.py .
nano README.md # coller le README
nano LICENSE # coller la licence
nano CHANGELOG.md # coller le changelog
nano CONTRIBUTING.md # coller le contributing
nano SECURITY.md # coller le security
nano .gitignore # coller le .gitignore ci-dessus
nano .gitattributes # coller le .gitattributes
nano .editorconfig # coller le .editorconfig

mkdir -p .github/workflows assets docs examples tests
nano .github/workflows/test.yml

chmod +x nexus_runner.py

# Vérification
python3 -m py_compile nexus_runner.py

# Test local
python3 nexus_runner.py ls ~/Documents

# Commit initial
git add .
git status # doit montrer les bons fichiers
git commit -m "feat: initial release v2.0.0 NEXUS RUNNER"

# Tag
git tag -a v2.0.0 -m "NEXUS RUNNER v2.0.0 — Detect. Install. Build. Run."
git push origin main --tags

