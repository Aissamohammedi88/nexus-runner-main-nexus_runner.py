def lancer_commande(cmd, cwd, timeout=600):
if not cmd:
return {"ok": False, "rc": -1, "stdout": "", "stderr": "commande vide"}
try:
r = subprocess.run(cmd, shell=True, capture_output=True, text=True,
cwd=cwd, timeout=timeout)
return {"ok": r.returncode == 0, "rc": r.returncode,
"stdout": r.stdout[-20000:], "stderr": r.stderr[-10000:]}
except subprocess.TimeoutExpired:
return {"ok": False, "rc": 124, "stdout": "",
"stderr": "timeout " + str(timeout) + "s"}
except FileNotFoundError as e:
return {"ok": False, "rc": 127, "stdout": "", "stderr": str(e)[:200]}
except Exception as e:
return {"ok": False, "rc": 1, "stdout": "", "stderr": str(e)[:200]}


def lancer_en_arriere_plan(cmd, cwd):
pid = hashlib.sha256((cmd + cwd + str(time.time())).encode()).hexdigest()[:12]
out_file = os.path.join(PROCS_DIR, pid + ".log")
err_file = os.path.join(PROCS_DIR, pid + ".err")
try:
with open(out_file, "w", encoding="utf-8") as f_out, \
open(err_file, "w", encoding="utf-8") as f_err:
proc = subprocess.Popen(cmd, shell=True, cwd=cwd,
stdout=f_out, stderr=f_err,
stdin=subprocess.DEVNULL)
except Exception as e:
return {"ok": False, "err": str(e)[:200]}

info = {
"pid": proc.pid, "id": pid, "cmd": cmd, "cwd": cwd,
"started": datetime.datetime.now().isoformat(),
"out_file": out_file, "err_file": err_file, "proc": proc,
}
with PROCS_LOCK:
PROCS[pid] = info
return {"ok": True, "id": pid, "pid": proc.pid,
"out_file": out_file, "err_file": err_file}


def tuer_process(pid_id):
with PROCS_LOCK:
info = PROCS.get(pid_id)
if not info:
return {"ok": False, "err": "process inconnu"}
proc = info.get("proc")
if not proc:
return {"ok": False, "err": "deja termine"}
try:
proc.terminate()
try:
proc.wait(timeout=3)
except subprocess.TimeoutExpired:
proc.kill()
return {"ok": True, "id": pid_id}
except Exception as e:
return {"ok": False, "err": str(e)[:200]}


def lire_log_proc(pid_id, tail=300):
with PROCS_LOCK:
info = PROCS.get(pid_id)
if not info:
return {"ok": False, "err": "process inconnu"}
out = []
err = []
try:
with open(info["out_file"], "r", encoding="utf-8", errors="replace") as f:
out = f.read().splitlines()[-tail:]
except OSError:
pass
try:
with open(info["err_file"], "r", encoding="utf-8", errors="replace") as f:
err = f.read().splitlines()[-tail:]
except OSError:
pass
return {"ok": True, "id": pid_id, "pid": info["pid"],
"cmd": info["cmd"], "cwd": info["cwd"],
"stdout": "\n".join(out), "stderr": "\n".join(err)}


def statut_process(pid_id):
with PROCS_LOCK:
info = PROCS.get(pid_id)
if not info:
return {"ok": True, "existe": False}
proc = info.get("proc")
vivant = bool(proc and proc.poll() is None)
return {"ok": True, "existe": True, "id": pid_id,
"pid": info["pid"], "vivant": vivant,
"cmd": info["cmd"], "cwd": info["cwd"],
"started": info["started"]}


def lister_process():
with PROCS_LOCK:
ids = list(PROCS.keys())
return [statut_process(i) for i in ids]


