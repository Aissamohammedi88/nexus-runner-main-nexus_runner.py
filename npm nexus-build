elif type_projet == "go":
cmds["install"] = "go mod download"
cmds["build"] = "go build ./..."
cmds["start"] = "go run ."
cmds["test"] = "go test ./..."
cmds["description"] = "Go"

elif type_projet == "deno":
cmds["start"] = "deno task start || deno run -A main.ts"
cmds["description"] = "Deno"

elif type_projet == "java_maven":
