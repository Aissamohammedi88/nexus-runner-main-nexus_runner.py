class Handler(BaseHTTPRequestHandler):
server_version = "NexusRunner/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="application/json; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str))

def _html(self, code, text):
self._send(code, text, "text/html; charset=utf-8")

def _body_json(self):
try:
length = int(self.headers.get("Content-Length", "0") or "0")
except Exception:
length = 0
if length <= 0 or length > 2_000_000:
return {}
try:
return json.loads(self.rfile.read(length).decode("utf-8", "ignore") or "{}")
except Exception:
return {}

def _parse(self):
p = urllib.parse.urlparse(self.path)
return p.path, urllib.parse.parse_qs(p.query)

def do_GET(self):
path, qs = self._parse()
try:
if path in ("/", "/index.html"):
return self._html(200, HTML.replace("__V__", VERSION))

if path == "/api/explorer":
chemin = qs.get("chemin", [RACINE_DEFAUT])[0]
chemin = os.path.expanduser(chemin) if chemin else RACINE_DEFAUT
if not os.path.isdir(chemin):
return self._json(404, {"ok": False,
"err": "dossier introuvable"})
r = dossiers_adjoints(chemin, profondeur=3)
if r.get("ok"):
parent = os.path.dirname(r["racine"]) or "/"
r["parent"] = parent
return self._json(200, r)

if path == "/api/status":
return self._json(200, {
"ok": True, "version": VERSION, "auteur": AUTEUR,
"host": HOST, "port": PORT,
"base": BASE, "racine_navigation": RACINE_DEFAUT,
"log": LOG_FILE,
"nb_procs": len(PROCS),
"outils": {
"node": bool(shutil.which("node")),
"npm": bool(shutil.which("npm")),
"pnpm": bool(shutil.which("pnpm")),
"yarn": bool(shutil.which("yarn")),
"bun": bool(shutil.which("bun")),
"python3": bool(shutil.which("python3")),
"pip3": bool(shutil.which("pip3")),
"cargo": bool(shutil.which("cargo")),
"go": bool(shutil.which("go")),
"java": bool(shutil.which("java")),
"docker": bool(shutil.which("docker")),
"make": bool(shutil.which("make")),
"cmake": bool(shutil.which("cmake")),
},
})

if path == "/api/procs":
return self._json(200, {"ok": True, "items": lister_process()})

if path == "/api/log":
return self._json(200, lire_log_proc(qs.get("id", [""])[0]))

if path == "/api/statut":
return self._json(200, statut_process(qs.get("id", [""])[0]))

if path == "/api/ping":
return self._json(200, {"ok": True, "ping": "pong"})

return self._json(404, {"ok": False, "err": "route inconnue"})
except Exception as e:
log("GET err " + str(e)[:150])
return self._json(500, {"ok": False, "err": str(e)[:200]})

def do_POST(self):
path, qs = self._parse()
try:
data = self._body_json()

if path == "/api/detect":
chemin = os.path.expanduser(data.get("chemin", ""))
if not os.path.isdir(chemin):
return self._json(404, {"ok": False,
"err": "dossier introuvable"})
d = detecter_type(chemin)
if not d:
return self._json(200, {"ok": False,
"err": "aucun projet reconnu"})
cmds = commandes_pour(d["type"], chemin)
return self._json(200, {
"ok": True, "chemin": chemin, "detection": d,
"commandes": {k: v for k, v in cmds.items() if v},
})

if path == "/api/run":
chemin = os.path.expanduser(data.get("chemin", ""))
mode = data.get("mode", "auto")
if mode == "dry":
d = detecter_type(chemin)
if not d:
return self._json(200, {"ok": False,
"err": "aucun projet reconnu"})
cmds = commandes_for if False else commandes_pour(d["type"], chemin)
return self._json(200, {
"ok": True, "detection": d, "mode": "dry",
"commandes": {k: v for k, v in cmds.items() if v},
"etapes": [],
})

r = pipeline(chemin, mode=mode,
skip_install=bool(data.get("skip_install")),
skip_build=bool(data.get("skip_build")))
return self._json(200, r)

if path == "/api/kill":
return self._json(200, tuer_process(data.get("id", "")))

return self._json(404, {"ok": False, "err": "route inconnue"})
except Exception as e:
log("POST err " + str(e)[:150])
log(traceback.format_exc()[-500:])
return self._json(500, {"ok": False, "err": str(e)[:200]})

def do_OPTIONS(self):
try:
self.send_response(204)
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "*")
self.send_header("Content-Length", "0")
self.end_headers()
except Exception:
pass


