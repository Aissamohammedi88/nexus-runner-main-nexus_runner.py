# PIPELINE
# ═══════════════════════════════════════════════════════════════════════════

def pipeline(chemin, mode="auto", skip_install=False, skip_build=False,
timeout_install=600, timeout_build=600):
resultat = {"ok": False, "chemin": chemin, "mode": mode,
"etapes": [], "started_proc_id": None}

if not os.path.isdir(chemin):
resultat["err"] = "dossier introuvable : " + chemin
return resultat

detection = detecter_type(chemin)
if not detection:
resultat["err"] = "aucun type de projet reconnu dans " + chemin
return resultat
resultat["detection"] = detection
log("Detecte : " + detection["type"] + " @ " + chemin)

cmds = commandes_pour(detection["type"], chemin)
resultat["commandes"] = {k: v for k, v in cmds.items() if v}

# INSTALL
if not skip_install and cmds.get("install") and mode != "start":
log("Install : " + cmds["install"])
etape = {"nom": "install", "cmd": cmds["install"]}
r = lancer_commande(cmds["install"], chemin, timeout=timeout_install)
etape.update({"ok": r["ok"], "rc": r["rc"],
"stdout": r["stdout"][-3000:],
"stderr": r["stderr"][-3000:]})
resultat["etapes"].append(etape)
if not r["ok"]:
resultat["err"] = "install echoue (rc=" + str(r["rc"]) + ")"
return resultat
else:
resultat["etapes"].append({"nom": "install", "skip": True})

# BUILD
if not skip_build and cmds.get("build") and mode != "start":
log("Build : " + cmds["build"])
etape = {"nom": "build", "cmd": cmds["build"]}
r = lancer_commande(cmds["build"], chemin, timeout=timeout_build)
etape.update({"ok": r["ok"], "rc": r["rc"],
"stdout": r["stdout"][-5000:],
"stderr": r["stderr"][-3000:]})
resultat["etapes"].append(etape)
if not r["ok"]:
resultat["err"] = "build echoue (rc=" + str(r["rc"]) + ")"
return resultat
else:
resultat["etapes"].append({"nom": "build", "skip": True})

# START
if mode in ("auto", "start") and cmds.get("start"):
log("Start (arriere-plan) : " + cmds["start"])
r = lancer_en_arriere_plan(cmds["start"], chemin)
etape = {"nom": "start", "cmd": cmds["start"], "ok": r.get("ok", False)}
if r.get("ok"):
etape["proc_id"] = r["id"]
etape["pid"] = r["pid"]
resultat["started_proc_id"] = r["id"]
else:
etape["err"] = r.get("err", "?")
resultat["etapes"].append(etape)

resultat["ok"] = True
return resultat


