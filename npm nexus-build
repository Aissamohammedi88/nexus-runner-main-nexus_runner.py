def dossiers_adjoints(chemin, profondeur=3):
"""Liste les sous-dossiers jusqu'a une profondeur donnee,
en marquant ceux qui sont des projets."""
if not os.path.isdir(chemin):
return {"ok": False, "err": "dossier introuvable"}

chemin = os.path.abspath(chemin)
if not chemin.startswith(HOME):
# Securite : on reste dans HOME
return {"ok": False, "err": "hors de chez toi (HOME)"}

resultat = []

def scan(d, prof, prefixe=""):
if prof <= 0:
return
try:
entrees = sorted(os.listdir(d))
except OSError:
return
for nom in entrees:
if nom.startswith(".") and nom not in (".git",):
continue
if nom in ("node_modules", "__pycache__", "venv", ".venv",
"target", "build", "dist", "Procs", ".cache"):
continue
full = os.path.join(d, nom)
if not os.path.isdir(full):
continue
det = detecter_type(full)
rel = os.path.relpath(full, chemin)
item = {
"nom": nom,
"chemin": full,
"rel": rel,
"profondeur": prof,
"est_projet": bool(det),
"type": det["type"] if det else None,
"fichiers": det["fichiers"] if det else [],
}
resultat.append(item)
scan(full, prof - 1)

scan(chemin, profondeur)
return {"ok": True, "racine": chemin, "items": resultat}


