def log(msg):
ts = time.strftime("%Y-%m-%d %H:%M:%S")
line = "[{}] {}".format(ts, msg)
try:
print(line, flush=True)
except Exception:
pass
with LOG_LOCK:
try:
with open(LOG_FILE, "a", encoding="utf-8") as f:
f.write(line + "\n")
except OSError:
pass


