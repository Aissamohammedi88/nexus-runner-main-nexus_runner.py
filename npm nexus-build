def detecter_type(chemin):
if not os.path.isdir(chemin):
return None
trouves = []
for fichier, typ in MARQUEURS:
if os.path.isfile(os.path.join(chemin, fichier)):
trouves.append((fichier, typ))
if not trouves:
return None
for p in PRIO:
for f, t in trouves:
if t == p:
return {"type": t, "fichiers": [m[0] for m in trouves]}
return {"type": "inconnu", "fichiers": [m[0] for m in trouves]}


def lire_package_json(chemin):
p = os.path.join(chemin, "package.json")
if not os.path.isfile(p):
return None
try:
with open(p, "r", encoding="utf-8") as f:
return json.load(f)
except Exception:
return None


def commandes_pour(type_projet, chemin):
cmds = {"install": None, "build": None, "start": None, "dev": None,
"test": None, "description": ""}

if type_projet in ("node", "node_pnpm", "node_yarn", "node_bun"):
pkg = lire_package_json(chemin) or {}
scripts = pkg.get("scripts", {})

if type_projet == "node_pnpm" or shutil.which("pnpm"):
cmds["install"] = "pnpm install"
elif type_projet == "node_yarn" or shutil.which("yarn"):
cmds["install"] = "yarn install"
elif type_projet == "node_bun" or shutil.which("bun"):
cmds["install"] = "bun install"
else:
cmds["install"] = "npm install"

if "build" in scripts:
cmds["build"] = "npm run build"
if "start" in scripts:
cmds["start"] = "npm start"
elif "dev" in scripts:
cmds["start"] = "npm run dev"
if "dev" in scripts:
cmds["dev"] = "npm run dev"
if "test" in scripts:
cmds["test"] = "npm test"
cmds["description"] = "Node.js : " + pkg.get("name", "?")

elif type_projet in ("python", "python_poetry", "python_pipenv"):
if type_projet == "python_poetry":
cmds["install"] = "poetry install"
cmds["start"] = "poetry run python main.py"
elif type_projet == "python_pipenv":
cmds["install"] = "pipenv install"
cmds["start"] = "pipenv run python main.py"
else:
cmds["install"] = "pip3 install -r requirements.txt"
for nom in ("main.py", "app.py", "server.py", "run.py", "manage.py"):
if os.path.isfile(os.path.join(chemin, nom)):
if nom == "manage.py":
cmds["start"] = "python3 manage.py runserver"
else:
cmds["start"] = "python3 " + nom
break
cmds["description"] = "Python"

elif type_projet == "rust":
cmds["install"] = "cargo fetch"
cmds["build"] = "cargo build --release"
cmds["start"] = "cargo run"
cmds["test"] = "cargo test"
