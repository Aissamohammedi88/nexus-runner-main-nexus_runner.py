cmds["build"] = "mvn package -DskipTests"
cmds["start"] = "mvn spring-boot:run || java -jar target/*.jar"
cmds["description"] = "Java Maven"

elif type_projet == "java_gradle":
cmds["build"] = "./gradlew build -x test || gradle build -x test"
cmds["start"] = "./gradlew bootRun || gradle run"
cmds["description"] = "Java Gradle"

elif type_projet == "make":
cmds["build"] = "make"
cmds["start"] = "make run || ./a.out"
